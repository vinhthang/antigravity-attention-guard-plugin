{
  "attention-guard-plugin": {
    "PreToolUse": [
      {
        "matcher": "run_command|replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 ./scripts/enforce-delegation.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "/usr/bin/env python3 ./scripts/attention-guard.py --timeout 120",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "/usr/bin/env python3 ./scripts/attention-check.py --timeout 120",
        "timeout": 5
      }
    ]
  }
}
