{
  "attention-guard-plugin": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 ./scripts/enforce-delegation.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 ./scripts/inject-rules.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "/usr/bin/env python3 ./scripts/attention-check.py",
        "timeout": 5
      }
    ]
  }
}
