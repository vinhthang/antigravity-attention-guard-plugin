{
  "attention-guard-plugin": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|run_command|send_message|invoke_subagent|manage_subagents|run_workflow|swarm",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 ./scripts/enforce-delegation.py",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 ./scripts/inject-rules.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
